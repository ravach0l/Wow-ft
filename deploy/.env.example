# Öffentliche Adresse (ohne / am Ende)
WOWFT_BASE_URL=https://wow.the-birds.xyz
# Zufallswert, z. B. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WOWFT_SECRET_KEY=
# Authentik: Provider "OAuth2/OpenID", Application-Slug "wowft"
WOWFT_OIDC_METADATA_URL=https://auth.the-birds.xyz/application/o/wowft/.well-known/openid-configuration
WOWFT_OIDC_CLIENT_ID=
WOWFT_OIDC_CLIENT_SECRET=
# Admins (Komma-getrennt): Authentik-Benutzername oder E-Mail.
# Admins schalten im Profil Module wie das Level-Rennen ein und aus.
WOWFT_ADMIN_USERS=
# Maximallevel für "Zeit bis 60"
WOWFT_MAX_LEVEL=60
# Nur die Adresse von Caddy darf X-Forwarded-For setzen (Docker-Bridge o. ä.)
FORWARDED_ALLOW_IPS=*
